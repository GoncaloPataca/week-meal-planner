{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe Pool",
  "description": "Array of recipes used as the source pool by generate-week.js.",
  "type": "array",
  "items": { "$ref": "#/definitions/Recipe" },
  "definitions": {
    "Ingredient": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name":   { "type": "string", "minLength": 1 },
        "amount": { "type": "string" }
      }
    },
    "Nutrition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calories": { "type": ["number", "null"], "minimum": 0 },
        "protein":  { "type": ["number", "null"], "minimum": 0 },
        "carbs":    { "type": ["number", "null"], "minimum": 0 },
        "fat":      { "type": ["number", "null"], "minimum": 0 },
        "fiber":    { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "Recipe": {
      "type": "object",
      "required": ["id", "name", "ingredients", "steps"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": ["number", "string"] },
        "name":        { "type": "string", "minLength": 1 },
        "ingredients": { "type": "array", "items": { "$ref": "#/definitions/Ingredient" } },
        "steps":       { "type": "array", "items": { "type": "string" } },
        "tags":        { "type": "array", "items": { "type": "string" } },
        "prepTime":    { "type": ["string", "null"] },
        "cookTime":    { "type": ["string", "null"] },
        "totalTime":   { "type": ["string", "null"] },
        "servings":    { "type": "number", "minimum": 1 },
        "url":         { "type": ["string", "null"], "format": "uri" },
        "image":       { "type": ["string", "null"] },
        "nutrition":   { "oneOf": [{ "$ref": "#/definitions/Nutrition" }, { "type": "null" }] }
      }
    }
  }
}

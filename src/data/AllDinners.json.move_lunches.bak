  {
    "id": "D12",
    "name": "Massada de Peixe à Portuguesa",
    "ingredients": [
      { "amount": "300g", "name": "Massa de arroz (cotovelos)" },
      { "amount": "400g", "name": "Peixe branco em cubos (pescada ou robalo)" },

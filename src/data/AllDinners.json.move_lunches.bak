[
  {
    "id": "D01",
    "name": "Frango Assado com Batata-Doce e Alecrim",
    "ingredients": [
      { "amount": "4 coxas", "name": "Frango (coxas com pele)" },
      { "amount": "2 unidades médias", "name": "Batata-doce" },
      { "amount": "4 ramos", "name": "Alecrim fresco" },
      { "amount": "4 dentes", "name": "Alho" },
      { "amount": "3 colheres de sopa", "name": "Azeite" },
      { "amount": "1 unidade", "name": "Limão" },
      { "amount": "a gosto", "name": "Sal, pimenta e pimentão fumado" }
    ],
    "steps": [
      "Pré-aqueça o forno a 200°C.",
      "Corte a batata-doce em meias-luas e disponha num tabuleiro com azeite e alecrim.",
      "Coloque as coxas por cima, tempere com sal, pimenta, pimentão fumado e raspa de limão.",
      "Espalhe os dentes de alho inteiros pelo tabuleiro.",
      "Asse 40-45 minutos até o frango estar dourado e a batata macia.",
      "Sirva com sumo de limão por cima."
    ],
    "tags": ["sem glúten", "sem lactose", "frango", "jantar"],
    "servings": 4,
    "prepTime": "10 min",
    "cookTime": "45 min",
    "calories": 480,
    "url": null,
    "image": "/images/recipes/frango-batata-doce.jpg"
  },
  {
    "id": "D02",
    "name": "Bacalhau com Grão e Espinafres",
    "ingredients": [
      { "amount": "400g", "name": "Bacalhau desfiado (demolhado)" },
      { "amount": "1 lata (400g)", "name": "Grão-de-bico cozido" },
      { "amount": "2 punhados", "name": "Espinafres frescos" },
      { "amount": "3 dentes", "name": "Alho" },
      { "amount": "1 unidade", "name": "Cebola" },
      { "amount": "4 colheres de sopa", "name": "Azeite" },
      { "amount": "2 ovos", "name": "Ovos cozidos (guarnição)" },
      { "amount": "a gosto", "name": "Sal, pimenta e salsa" }
    ],
    "steps": [
      "Refogue a cebola e o alho em azeite até amolecerem.",
      "Adicione o bacalhau e cozinhe 5 minutos.",
      "Junte o grão-de-bico e mexa bem.",
      "Incorpore os espinafres e cozinhe até murcharem.",
      "Sirva com ovos cozidos cortados ao meio e salsa picada."
    ],
    "tags": ["sem glúten", "sem lactose", "peixe", "jantar", "tradicional"],
    "servings": 3,

  {
    "id": "D03",
    "name": "Caril de Camarão com Leite de Coco",
    "ingredients": [
      { "amount": "400g", "name": "Camarão descascado" },
      { "amount": "1 lata (400ml)", "name": "Leite de coco" },
      { "amount": "2 colheres de chá", "name": "Pasta de caril amarelo" },
      { "amount": "1 unidade", "name": "Cebola picada" },
      { "amount": "2 dentes", "name": "Alho picado" },
      { "amount": "1 pedaço (2cm)", "name": "Gengibre fresco ralado" },
      { "amount": "1 punhado", "name": "Coentros frescos" },
      { "amount": "1 colher de sopa", "name": "Óleo de coco" },
      { "amount": "a gosto", "name": "Sal e sumo de lima" }
    ],
    "steps": [
      "Refogue a cebola, o alho e o gengibre em óleo de coco por 3 minutos.",
      "Adicione a pasta de caril e mexa 1 minuto.",
      "Deite o leite de coco e deixe ferver em lume brando 5 minutos.",
      "Junte o camarão e cozinhe 4-5 minutos até estar rosado.",
      "Rectifique o sal, adicione sumo de lima e coentros. Sirva com arroz."
    ],
    "tags": ["sem glúten", "sem lactose", "marisco", "jantar"],
    "servings": 3,

      { "amount": "1 unidade", "name": "Cebola" },
      { "amount": "3 dentes", "name": "Alho" },
      { "amount": "1 colher de chá", "name": "Cominhos" },
      { "amount": "1 colher de chá", "name": "Pimentão fumado" },
      { "amount": "3 colheres de sopa", "name": "Azeite" },
      { "amount": "a gosto", "name": "Sal e pimenta" }
    ],
    "steps": [
      "Refogue a cebola e o alho em azeite até ficarem macios.",
      "Adicione os cominhos e o pimentão. Mexa 30 segundos.",
      "Junte o tomate pelado e esmague com uma colher. Cozinhe 10 minutos.",
      "Adicione o grão-de-bico e cozinhe mais 10 minutos.",
      "Incorporate os espinafres, cozinhe 2 minutos e sirva."

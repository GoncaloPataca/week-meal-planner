  {
    "id": "D04",
    "name": "Lombo de Porco com Maçã e Mostarda",
    "ingredients": [
      { "amount": "600g", "name": "Lombo de porco" },
      { "amount": "2 unidades", "name": "Maçã" },
      { "amount": "1 colher de sopa", "name": "Mostarda de Dijon" },
      { "amount": "2 colheres de sopa", "name": "Mel" },
      { "amount": "2 dentes", "name": "Alho" },
      { "amount": "200ml", "name": "Caldo de frango" },
      { "amount": "2 colheres de sopa", "name": "Azeite" },
      { "amount": "a gosto", "name": "Sal, pimenta e tomilho" }
    ],
    "steps": [
      "Pré-aqueça o forno a 180°C.",
      "Sele o lombo em azeite quente de todos os lados numa frigideira.",
      "Misture mostarda, mel e alho picado. Barre o lombo com esta mistura.",
      "Corte as maçãs em quartos e disponha em volta da carne num tabuleiro.",
      "Deite o caldo, polvilhe com tomilho e asse 35 minutos.",
      "Deixe repousar 5 minutos antes de fatiar."
    ],
    "tags": ["sem glúten", "sem lactose", "carne", "jantar"],
    "servings": 4,
    "prepTime": "10 min",
    "cookTime": "40 min",
    "calories": 450,
    "url": null,

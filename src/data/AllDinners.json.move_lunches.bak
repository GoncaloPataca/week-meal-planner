  {
    "id": "D06",
    "name": "Estufado de Grão com Tomate e Espinafres",
    "ingredients": [
      { "amount": "2 latas (800g)", "name": "Grão-de-bico cozido" },
      { "amount": "1 lata (400g)", "name": "Tomate pelado" },

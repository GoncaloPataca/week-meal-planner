  {
    "id": "D08",
    "name": "Peixe-Espada com Banana e Batata Cozida",
    "ingredients": [
      { "amount": "4 filetes", "name": "Peixe-espada" },
      { "amount": "2 unidades", "name": "Banana" },
      { "amount": "4 unidades médias", "name": "Batata" },
      { "amount": "3 colheres de sopa", "name": "Farinha de arroz" },
      { "amount": "3 colheres de sopa", "name": "Azeite" },
      { "amount": "1 unidade", "name": "Limão" },
      { "amount": "a gosto", "name": "Sal e pimenta" }
    ],
    "steps": [
      "Coza as batatas em água com sal durante 20 minutos.",
      "Tempere os filetes de peixe-espada com sal e pimenta. Passe na farinha de arroz.",
      "Frite em azeite quente 3-4 minutos de cada lado até dourar.",
      "Na mesma frigideira, frite as bananas cortadas ao meio 1-2 minutos.",
      "Sirva o peixe com a banana, batata cozida e gomos de limão."
    ],

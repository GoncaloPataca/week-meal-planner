  {
    "id": "D11",
    "name": "Hambúrguer de Lentilhas com Salada",
    "ingredients": [
      { "amount": "250g", "name": "Lentilhas vermelhas cozidas" },
      { "amount": "1/2 xícara (40g)", "name": "Farinha de aveia" },
      { "amount": "1 unidade", "name": "Cebola picada" },
      { "amount": "2 dentes", "name": "Alho picado" },
      { "amount": "1 colher de chá", "name": "Cominhos" },
      { "amount": "1 colher de chá", "name": "Pimentão fumado" },
      { "amount": "2 colheres de sopa", "name": "Azeite" },
      { "amount": "Folhas de alface, tomate, pepino", "name": "Salada" },
      { "amount": "a gosto", "name": "Sal e pimenta" }
    ],
    "steps": [
      "Refogue a cebola e o alho até amolecer. Deixe arrefecer.",
      "Esmague as lentilhas grosseiramente. Misture com a farinha, cebola, alho e especiarias.",
      "Molde em 4 hambúrgueres. Leve ao frigorífico 20 minutos para firmar.",
      "Grelhe ou cozinhe em azeite 4 minutos de cada lado.",
      "Sirva com a salada e molho a gosto."

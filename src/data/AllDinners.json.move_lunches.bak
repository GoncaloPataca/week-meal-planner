  {
    "id": "D09",
    "name": "Carne Assada com Cenouras e Ervas",
    "ingredients": [
      { "amount": "800g", "name": "Novilho para assar (acém ou chambão)" },
      { "amount": "4 unidades", "name": "Cenoura" },
      { "amount": "1 unidade", "name": "Cebola" },
      { "amount": "4 dentes", "name": "Alho" },
      { "amount": "200ml", "name": "Vinho tinto (opcional)" },
      { "amount": "300ml", "name": "Caldo de carne" },
      { "amount": "3 colheres de sopa", "name": "Azeite" },
      { "amount": "a gosto", "name": "Sal, pimenta, louro e tomilho" }
    ],
    "steps": [
      "Pré-aqueça o forno a 160°C.",
      "Sele a carne em azeite quente de todos os lados.",
      "Retire a carne. Refogue a cebola e o alho no mesmo tacho.",
      "Deite o vinho, deixe evaporar a metade. Adicione o caldo e as ervas.",
      "Coloque a carne de volta. Adicione as cenouras. Tape e asse 2h30.",
      "A carne deve desfiar facilmente. Sirva com o molho coado."
    ],
    "tags": ["sem glúten", "sem lactose", "carne", "jantar"],
    "servings": 5,

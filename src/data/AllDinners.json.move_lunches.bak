  {
    "id": "D10",
    "name": "Dourada Grelhada com Salsa Verde",
    "ingredients": [
      { "amount": "2 unidades (400g cada)", "name": "Dourada inteira limpa" },
      { "amount": "1 punhado", "name": "Salsa fresca" },
      { "amount": "1 punhado", "name": "Coentros frescos" },
      { "amount": "1 dente", "name": "Alho" },
      { "amount": "3 colheres de sopa", "name": "Azeite" },
      { "amount": "1 unidade", "name": "Limão" },
      { "amount": "a gosto", "name": "Sal e pimenta" }
    ],
    "steps": [
      "Triture a salsa, os coentros, o alho, o sumo de limão e o azeite para fazer a salsa verde.",
      "Faça 3 cortes em diagonal em cada dourada. Tempere com sal e pimenta por dentro e por fora.",
      "Grelhe na grelha ou frigideira quente 5-6 minutos de cada lado.",
      "Sirva com a salsa verde por cima e limão para espremer."
    ],
    "tags": ["sem glúten", "sem lactose", "peixe", "jantar"],

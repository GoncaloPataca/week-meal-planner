  {
    "id": "D13",
    "name": "Tofu Salteado com Brócolos e Arroz",
    "ingredients": [
      { "amount": "400g", "name": "Tofu firme" },
      { "amount": "1 cabeça", "name": "Brócolos" },
      { "amount": "1 xícara (185g)", "name": "Arroz branco" },
      { "amount": "2 colheres de sopa", "name": "Molho tamari (sem glúten)" },
      { "amount": "1 colher de sopa", "name": "Óleo de sésamo" },
      { "amount": "2 dentes", "name": "Alho" },
      { "amount": "1 pedaço", "name": "Gengibre fresco" },
      { "amount": "1 colher de sopa", "name": "Sementes de sésamo" }
    ],
    "steps": [
      "Cozinhe o arroz e reserve.",
      "Escorra o tofu e seque bem. Corte em cubos.",
      "Frite o tofu em óleo quente até dourar de todos os lados. Reserve.",
      "No mesmo wok, salteie o alho e o gengibre. Adicione os brócolos e salteie 4 minutos.",
      "Junte o tofu e o tamari. Mexa bem.",
      "Sirva sobre o arroz com óleo de sésamo e sementes."
    ],

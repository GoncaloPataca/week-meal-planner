{
  "name": "Probiotic Bircher Muesli",
  "url": "https://www.mob.co.uk/recipes/probiotic-bircher-muesli",
  "image": "https://files.mob-cdn.co.uk/recipes/2024/10/probitic-bircher-museli.jpg",
  "servings": 1,
  "ingredients": [
    "1 Apple",
    "100g Kefir",
    "2tbsp Greek Yoghurt",
    "1tsp Ground Cinnamon",
    "50g Oats",
    "50ml Milk",
    "40g Mixed Seeds",
    "25g Raisin",
    "Mixed Nuts (to serve)",
    "Mixed Seeds (to serve)"
  ],
  "steps": [
    "Grate the apple into a large bowl before mixing in the remaining ingredients.",
    "Cover and place in the fridge for at least a couple of hours and ideally overnight.",
    "To serve, sprinkle over any nuts or seeds you like. Enjoy!"
  ],

        "name": "de sopa de colorau"
      },
      {
        "amount": "Q.b. Sal",
        "name": "Q.b. Sal"
      },
      {
        "amount": "Q.b.",
        "name": "Pimenta preta"
      },
      {
        "amount": "2",
        "name": "Laranjas"
      },
      {
        "amount": "2",
        "name": "laranjas em gomos"
      },
      {
        "amount": "q.b.",
        "name": "Queijo feta (opcional)"
      },
      {
        "amount": "q.b.",
        "name": "Salsa, a gosto"

  {
    "id": "L199",
    "name": "Bacalhau na abóbora",
    "url": "https://www.apitadadopai.com/bacalhau-na-abobora/",
    "image": "/images/recipes/bacalhau-na-abobora.jpg",
    "servings": 4,
    "prepTime": "1 hour&nbsp;",
    "cookTime": null,
    "ingredients": [
      {
        "amount": "1",
        "name": "Abóbora"
      },
      {
        "amount": "2",
        "name": "postas bacalhau"
      },
      {
        "amount": "10",
        "name": "camarões"
      },
      {
        "amount": "1",
        "name": "broa de milho pequena"
      },
      {
        "amount": "q.b.",
        "name": "Grelos ou espinafres"

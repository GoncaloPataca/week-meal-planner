    "url": "https://www.apitadadopai.com/timbale-de-polvo-com-migas-de-aveia-e-tomate/",
    "image": "/images/recipes/timbale-de-polvo-com-migas-de-aveia-e-tomate.jpg",
    "servings": 4,
    "prepTime": null,
    "cookTime": null,
    "ingredients": [
      {
        "amount": "2 uni",
        "name": "Dentes de alho"
      },
      {
        "amount": "Fio",
        "name": "de zeite"
      },
      {
        "amount": "1 uni",
        "name": "Tomate em pedaços da Guloso"
      },
      {
        "amount": "1 chávena",
        "name": "Flocos de aveia"
      },
      {
        "amount": "q.b.",
        "name": "Água (q.b. – o suficiente para cobrir a aveia)"
      },
      {
        "amount": "Sal",
        "name": "e pimenta a gosto"
      },
      {
        "amount": "q.b.",
        "name": "Espinafres frescos"
      },
      {
        "amount": "Fio",
        "name": "de azeite"
      },
      {
        "amount": "q.b.",
        "name": "Polvo cozido (cortado aos pedaços)"
      },
      {
        "amount": "q.b.",
        "name": "Talos de coentros picados"
      },
      {
        "amount": "2 uni",
        "name": "Dentes de alho"
      },
      {
        "amount": "Sal",
        "name": "e pimenta (q.b)"
      },

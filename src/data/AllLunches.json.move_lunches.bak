        "name": "maçãs, descascadas e cortadas em fatias finas"
      },
      {
        "amount": "150 g",
        "name": "queijo brie, cortado em fatias"
      },
      {
        "amount": "2 colheres",
        "name": "de sopa azeite"
      },
      {
        "amount": "2 colheres",
        "name": "de sopa manteiga"
      },

[
  {
    "id": "L15",
    "name": "Lasanha de Frango",
    "ingredients": [
      {
        "amount": "2 dentes",
        "name": "Alho"
      },
      {
        "amount": "1 unidade",
        "name": "Cebola"
      },
      {
        "amount": "1 unidade",
        "name": "Cenoura ralada"
      },
      {
        "amount": "1 dl",
        "name": "Vinho branco"
      },
      {
        "amount": "600 g",
        "name": "Peito de frango desfiado"
      },
      {
        "amount": "2 colheres de sopa",
        "name": "Azeite"
      },
      {
        "amount": "300 g",
        "name": "Placas de lasanha fresca"
      },
      {
        "amount": "a gosto",
        "name": "Sal e pimenta"
      },
      {
        "amount": "2 colheres de sopa",
        "name": "Queijo mozzarela light"
      },
      {
        "amount": "350 g",
        "name": "Couve-flor (para o béchamel)"
      },
      {
        "amount": "180 ml",
        "name": "Bebida vegetal sem açúcar"
      },
      {
        "amount": "a gosto",
        "name": "Noz-moscada"
      },
      {
        "amount": "a gosto",
        "name": "Sumo de limão"
      }
    ],
    "steps": [
      "Prepare o béchamel saudável: coza a couve-flor, escorra e triture com a bebida vegetal, sal, noz-moscada e sumo de limão até obter um creme liso.",
      "Pique os dentes de alho e a cebola e refogue tudo no azeite.",
      "Junte o vinho e a cenoura ralada. Refogue mais um pouco e acrescente o frango desfiado.",
      "Tempere com sal e pimenta. Ferva durante dois minutos e retire do lume.",
      "Retifique o tempero e misture parte do molho béchamel saudável no recheio.",
      "Num tabuleiro, alterne camadas de placas de lasanha, recheio de frango e béchamel.",
      "Termine com béchamel e polvilhe com queijo mozzarela.",
      "Leve ao forno a 180 °C durante 25 minutos até dourar."
    ],
    "tags": [
      "massas",
      "frango",
      "forno",
      "almoço"
    ],
    "servings": 4,

    "name": "Risoto de camarão e lima",
    "url": "https://www.apitadadopai.com/risoto-de-camarao-e-lima/",
    "image": "/images/recipes/risoto-de-camarao-e-lima.jpg",
    "servings": 4,
    "prepTime": "30 minutes",
    "cookTime": null,
    "ingredients": [
